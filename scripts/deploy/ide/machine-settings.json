{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.hermes/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true
  },
  "search.exclude": {
    "**/node_modules/**": true,
    "**/.hermes/**": true
  },
  "search.followSymlinks": false,
  "git.autofetch": false
}
